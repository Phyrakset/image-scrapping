# Flask Server Settings
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=True

# API Keys for AI Image Generation
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# OpenRouter Multi-Profile API Keys (Cloud AI Models)
OPENROUTER_KEY_SOPHY_CODER=sk-or-v1-...
OPENROUTER_KEY_AHT50712=sk-or-v1-...
OPENROUTER_KEY_ASP25035=sk-or-v1-...
OPENROUTER_KEY_DEFAULT=sk-or-v1-...
OPENROUTER_KEY_SOPHYSET2016=sk-or-v1-...
