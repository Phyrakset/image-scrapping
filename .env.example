# Scraping & AI Filtering Settings
IMAGES_PER_POSITION=40
SEARCH_SUFFIX=Single Person Asian
ONLY_AI_PERSON=false
DOWNLOAD_DELAY=2
BASE_DOWNLOAD_DIR=downloads
POSITION_FILE=position.text

